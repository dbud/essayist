{
  "allowScripts": {},
  "compilerOptions": {
    "lib": [
      "deno.ns",
      "deno.window",
      "esnext",
      "esnext.iterator",
      "deno.unstable"
    ]
  },
  "deploy": {
    "app": "essayist",
    "org": "dbud"
  },
  "exclude": [".worktrees"],
  "imports": {
    "@biomejs/biome": "npm:@biomejs/biome@^2.5.14",
    "@openrouter/agent": "npm:@openrouter/agent@^0.11.0",
    "@openrouter/sdk": "npm:@openrouter/sdk@^0.13.67",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/collections": "jsr:@std/collections@^1.4.0",
    "husky": "npm:husky@^9.1.7",
    "pino-pretty": "npm:pino-pretty@^13.1.3"
  },
  "lint": {
    "exclude": ["patches"]
  },
  "nodeModulesDir": "auto",
  "tasks": {
    "check": "deno lint && deno check && deno run -A npm:@biomejs/biome check --error-on-warnings",
    "fmt": "deno run -A npm:@biomejs/biome check --write --error-on-warnings",
    "kvctl": "deno run -A --env-file=.env packages/kvctl/kvctl.ts",
    "rust:check": "cargo check",
    "rust:clippy": "cargo clippy --all-targets -- -D warnings",
    "wasm:build": "wasm-pack build crates/wasm --target web --out-dir pkg --out-name wasm",
    "wasm:build:dev": "wasm-pack build crates/wasm --target web --out-dir pkg --out-name wasm --dev"
  },
  "unstable": ["kv"],
  "workspace": [
    "./crates/wasm",
    "./packages/web",
    "./packages/core",
    "./packages/core/integration",
    "./packages/kvctl",
    "./patches/plugin-vite"
  ]
}
