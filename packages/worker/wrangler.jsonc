{
  "$schema": "node_modules/wrangler/config-schema.json",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_id": "553b3689-f25b-4848-a1f4-98da845f6caf",
      "database_name": "essayist-db"
    }
  ],
  "main": "./src/main.ts",
  "name": "essayist-worker",
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  },
  "upload_source_maps": true,
  "vars": {
    "LOG_LEVEL": "info"
  }
}
