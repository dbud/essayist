{
  "name": "@essayist/worker",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "build": "vite build",
    "check": "tsc --noEmit & app=$!; tsc --noEmit -p src/client; client=$?; wait $app && exit $client",
    "db:migrate": "wrangler d1 migrations apply essayist-db --remote",
    "db:migrate:local": "wrangler d1 migrations apply essayist-db --local",
    "deploy": "vite build && wrangler deploy",
    "dev": "vite dev",
    "favicon": "node scripts/favicon.ts",
    "favicon:check": "node scripts/favicon.ts --check",
    "fmt": "oxfmt . && pnpm -w fmt:comments",
    "lint": "oxlint .",
    "preview": "vite preview",
    "test": "vitest run",
    "test:do": "vitest run --config vitest.do.config.ts",
    "typegen": "wrangler types"
  },
  "dependencies": {
    "@effect/ai-openrouter": "catalog:",
    "@effect/sql-d1": "catalog:",
    "@essayist/core": "workspace:*",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/recursive": "^5.3.0",
    "@fontsource-variable/special-gothic": "^5.3.0",
    "@fontsource-variable/vollkorn": "^5.3.0",
    "@fontsource/ibm-plex-serif": "^5.3.0",
    "@hono/oauth-providers": "^0.9.1",
    "@lexical/clipboard": "^0.53.0",
    "@lexical/code": "^0.53.0",
    "@lexical/extension": "^0.53.0",
    "@lexical/history": "^0.53.0",
    "@lexical/html": "^0.53.0",
    "@lexical/link": "^0.53.0",
    "@lexical/list": "^0.53.0",
    "@lexical/mark": "^0.53.0",
    "@lexical/markdown": "^0.53.0",
    "@lexical/react": "^0.53.0",
    "@lexical/rich-text": "^0.53.0",
    "@preact/signals": "^2.11.4",
    "@sentry/browser": "^11.17.0",
    "@sentry/cloudflare": "^11.17.0",
    "@std/assert": "catalog:",
    "@std/collections": "catalog:",
    "@std/encoding": "catalog:",
    "@std/text": "catalog:",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "culori": "^4.0.2",
    "date-fns": "^4.4.0",
    "dompurify": "^3.5.0",
    "effect": "catalog:",
    "happy-dom": "^21.0.4",
    "hono": "^4.13.22",
    "jose": "catalog:",
    "lexical": "^0.53.0",
    "lucide-preact": "^1.80.0",
    "marked": "^18.3.0",
    "mermaid": "^12.3.0",
    "preact": "^11.2.0",
    "preact-render-to-string": "^6.8.3",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.2",
    "@cloudflare/vitest-plugin": "^1.9.2",
    "@cloudflare/workers-types": "catalog:",
    "@resvg/resvg-wasm": "2.6.2",
    "@sentry/vite-plugin": "^11.17.0",
    "@types/culori": "^4.0.1",
    "@types/gapi": "^0.0.47",
    "@types/google.accounts": "catalog:",
    "@types/google.picker": "^0.0.52",
    "@types/node": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:"
  },
  "client": {
    "allow": [
      "@fontsource/*",
      "@fontsource-variable/*",
      "@jsr/std__assert",
      "@jsr/std__collections",
      "@jsr/std__text",
      "@lexical/*",
      "@preact/signals",
      "@sentry/browser",
      "date-fns",
      "dompurify",
      "lexical",
      "lucide-preact",
      "preact"
    ],
    "budgets": {
      "admin": [
        "mermaid"
      ],
      "DebugSidebarContent": [
        "marked"
      ]
    }
  }
}
