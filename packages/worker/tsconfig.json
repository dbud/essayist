{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "lib": ["esnext", "esnext.iterator"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@/*": ["../core/src/*"]
    },
    "skipLibCheck": true,
    "strict": true,
    "target": "es2024",
    "types": ["@cloudflare/workers-types"]
  },
  "include": ["src", "vite.config.ts"]
}
