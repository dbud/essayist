{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": ["esnext", "esnext.iterator", "dom"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "noImplicitOverride": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2024",
    "types": [
      "node",
      "vite/client",
      "google.accounts",
      "gapi",
      "google.picker",
      "@cloudflare/vitest-plugin/types"
    ]
  },
  "exclude": ["src/client"],
  "include": ["src", "scripts", "tests", "worker-configuration.d.ts", "vite.config.ts"]
}
