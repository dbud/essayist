{
  "exports": "./mod.ts",
  "imports": {
    "@/": "./src/",
    "@effect/ai-openrouter": "npm:@effect/ai-openrouter@^4.0.3",
    "effect": "npm:effect@^4.0.3",
    "effect/ai/AiError": "npm:effect@^4.0.3/ai/AiError",
    "effect/http/FetchHttpClient": "npm:effect@^4.0.3/http/FetchHttpClient",
    "effect/http/HttpClientResponse": "npm:effect@^4.0.3/http/HttpClientResponse",
    "effect/testing": "npm:effect@^4.0.3/testing",
    "zod": "npm:zod@^4.6.5"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    }
  },
  "name": "@essayist/core",
  "publish": {
    "exclude": ["**/*_test.ts", "**/*.spec.ts"],
    "include": ["mod.ts", "src/**/*.ts", "deno.json"]
  },
  "tasks": {
    "check": "deno run -A npm:@biomejs/biome check && deno lint . && deno check",
    "test": "deno test -A --unstable-kv --coverage",
    "test:watch": "deno test -A --watch"
  },
  "version": "0.1.0"
}
