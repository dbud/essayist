{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "forceConsistentCasingInFileNames": true,
    "incremental": true,
    "isolatedModules": true,
    "lib": ["dom", "esnext", "esnext.iterator"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "es2024",
    "tsBuildInfoFile": "node_modules/.cache/tsc/app.tsbuildinfo"
  },
  "exclude": ["src/diff/diff_wasm_glue.ts", "src/diff/diff_wasm_test.ts"],
  "include": ["migrations", "mod.ts", "src", "vitest.config.ts"]
}
