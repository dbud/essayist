{
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "types": ["vite/client", "@types/gapi", "@types/google.picker"]
  },
  "exclude": ["**/_fresh/*"],
  "exports": "./main.ts",
  "imports": {
    "@/": "./",
    "@biomejs/biome": "npm:@biomejs/biome@^2.5.7",
    "@cliffy/command": "jsr:@cliffy/command@^1.2.1",
    "@deno/kv-oauth": "jsr:@deno/kv-oauth@^0.11",
    "@fontsource-variable/hanken-grotesk": "npm:@fontsource-variable/hanken-grotesk@^5.3.0",
    "@fontsource-variable/recursive": "npm:@fontsource-variable/recursive@^5.3.0",
    "@fontsource-variable/source-serif-4": "npm:@fontsource-variable/source-serif-4@^5.3.0",
    "@fontsource-variable/special-gothic": "npm:@fontsource-variable/special-gothic@^5.3.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.1.2",
    "@lexical/code": "npm:@lexical/code@^0.49.0",
    "@lexical/extension": "npm:@lexical/extension@^0.49.0",
    "@lexical/history": "npm:@lexical/history@^0.49.0",
    "@lexical/link": "npm:@lexical/link@^0.49.0",
    "@lexical/list": "npm:@lexical/list@^0.49.0",
    "@lexical/mark": "npm:@lexical/mark@^0.49.0",
    "@lexical/markdown": "npm:@lexical/markdown@^0.49.0",
    "@lexical/react": "npm:@lexical/react@^0.49.0",
    "@lexical/rich-text": "npm:@lexical/rich-text@^0.49.0",
    "@openrouter/agent": "npm:@openrouter/agent@^0.11.0",
    "@preact/signals": "npm:@preact/signals@^2.11.1",
    "@std/assert": "jsr:@std/assert@^1.0.19",
    "@std/text": "jsr:@std/text@^1.0.19",
    "@tailwindcss/typography": "npm:@tailwindcss/typography@^0.5.20",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.3.3",
    "@types/babel__core": "npm:@types/babel__core@^7.20.5",
    "@types/gapi": "npm:@types/gapi@^0.0.47",
    "@types/google.picker": "npm:@types/google.picker@^0.0.52",
    "@types/node": "npm:@types/node@^26.2.0",
    "dompurify": "npm:dompurify@^3.4.14",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "lexical": "npm:lexical@^0.49.0",
    "lucide-preact": "npm:lucide-preact@^1.34.0",
    "marked": "npm:marked@^18.0.11",
    "node:url": "node:url",
    "pngjs": "npm:pngjs@^7.0.0",
    "preact": "npm:preact@^10.29.8",
    "react": "npm:preact@^10.29.8/compat",
    "react-dom": "npm:preact@^10.29.8/compat",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "vite": "npm:vite@^7.3.6"
  },
  "lint": {
    "rules": {
      "tags": ["fresh", "recommended"]
    }
  },
  "name": "@essayist/web",
  "tasks": {
    "build": "vite build",
    "check": "deno run -A npm:@biomejs/biome check && deno lint . && deno check",
    "dev": "DENO_ENV=development vite | pino-pretty --colorize --translateTime SYS:standard --ignore pid,hostname",
    "kvctl": "deno run -A --env-file=.env kvctl.ts",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "version": "0.1.0"
}
