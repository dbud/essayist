{
  "name": "essayist",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -C packages/worker build",
    "check": "oxfmt --check . && oxlint --deny-warnings . && pnpm -r run check",
    "fmt": "oxfmt . && pnpm fmt:comments",
    "fmt:comments": "scripts/fmt-comments.sh",
    "lint": "oxlint .",
    "prepare": "husky && git config blame.ignoreRevsFile .git-blame-ignore-revs",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "husky": "^9.1.7",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "catalog:",
    "typescript-lsp": "npm:typescript@6.0.3",
    "vitest": "catalog:"
  },
  "packageManager": "pnpm@12.11.2"
}
