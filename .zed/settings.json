{
  "languages": {
    "CSS": {
      "code_actions_on_format": {
        "source.fixAll.biome": true
      },
      "formatter": "language_server",
      "language_servers": ["biome"]
    },
    "JavaScript": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": "language_server",
      "language_servers": [
        "biome",
        "vtsls",
        "!typescript-language-server",
        "!eslint"
      ]
    },
    "JSON": {
      "code_actions_on_format": {
        "source.fixAll.biome": true
      },
      "formatter": "language_server",
      "language_servers": ["biome"]
    },
    "JSONC": {
      "code_actions_on_format": {
        "source.fixAll.biome": true
      },
      "formatter": "language_server",
      "language_servers": ["biome"]
    },
    "Rust": {
      "formatter": "language_server",
      "language_servers": ["rust-analyzer"]
    },
    "TSX": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": "language_server",
      "language_servers": [
        "biome",
        "vtsls",
        "!typescript-language-server",
        "!eslint"
      ]
    },
    "TypeScript": {
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "formatter": "language_server",
      "language_servers": [
        "biome",
        "vtsls",
        "!typescript-language-server",
        "!eslint"
      ]
    }
  },
  "lsp": {
    "biome": {
      "settings": {
        "require_config_file": true
      }
    },
    "vtsls": {
      "settings": {
        "javascript": {
          "tsdk": "node_modules/typescript-lsp/lib",
          "tsserver": {
            "experimental": {
              "enableProjectDiagnostics": false
            }
          }
        },
        "typescript": {
          "tsdk": "node_modules/typescript-lsp/lib",
          "tsserver": {
            "experimental": {
              "enableProjectDiagnostics": false
            }
          }
        }
      }
    }
  }
}
